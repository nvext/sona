{
  "name": "sona",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} drizzle-kit migrate",
    "admin:catalog:build": "bun run server/infrastructure/admin/catalog/build.ts",
    "admin:catalog:sync": "bun run server/infrastructure/admin/catalog/sync.ts",
    "admin:catalog:apply": "bun run admin:catalog:build && bun run admin:catalog:sync",
    "admin:user:role": "bun run server/infrastructure/admin/users/set-role.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test:db": "bun test server/infrastructure/db/repos/tests",
    "test:db:test": "NODE_ENV=test bun test server/infrastructure/db/repos/tests",
    "test:telegram:smoke": "E2E_TELEGRAM_SMOKE=1 bun test ./server/infrastructure/services/checkout/tests/telegram-smoke.manual.ts"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "nuxt": "^4.2.2",
    "pg": "^8.18.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0"
  }
}
