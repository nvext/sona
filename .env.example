DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
TEST_DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME_TEST>
AUTH_SESSION_TTL=2592000000
AUTH_ACCESS_TTL=900000
AUTH_ACCESS_SECRET=dev-access-secret-change-me
AUTH_VERIFICATION_CODE_TTL=600000
AUTH_VERIFICATION_RESEND_COOLDOWN=60000
AUTH_CONTACT_VERIFICATION_PROVIDER=log
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_SECURE=false
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=
AUTH_PHONE_VERIFICATION_PROVIDER=log
AUTH_SMS_RU_API_ID=
AUTH_SMS_RU_FROM=
AUTH_SMS_RU_TEST=false
AUTH_PHONE_TELEGRAM_GATEWAY_ACCESS_TOKEN=
AUTH_PHONE_TELEGRAM_GATEWAY_SENDER_USERNAME=
ORDER_DELIVERY_PROVIDER=noop
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_MANAGER_CHAT_ID=<TELEGRAM_CHAT_ID>
LOG_LEVEL=info
TEST_LOG_LEVEL=silent
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_ADMIN_WRITE_MAX=60
ADMIN_UI_ENABLED=true
ADMIN_WRITE_CSRF_TOKEN=
ORDER_DELIVERY_RETRY_INTERVAL=30000
ORDER_DELIVERY_RETRY_BATCH_SIZE=20
ORDER_DELIVERY_MAX_ATTEMPTS=5
ORDER_DELIVERY_RETRY_BASE_DELAY=30000
ORDER_DELIVERY_RETRY_MAX_DELAY=3600000
