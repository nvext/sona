DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
AUTH_SESSION_TTL=2592000000
AUTH_ACCESS_TTL=900000
AUTH_ACCESS_SECRET=dev-access-secret-change-me
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_MANAGER_CHAT_ID=<TELEGRAM_CHAT_ID>
ORDER_DELIVERY_RETRY_INTERVAL=30000
ORDER_DELIVERY_RETRY_BATCH_SIZE=20
